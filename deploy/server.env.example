# Copy to deploy/server.env (never commit it) and fill in.

# the domain that points at this server (an A record to the droplet's IP); Caddy gets its HTTPS certificate for it
SIGNAGE_DOMAIN=signage.example.com

# the address designers open: the agent download's config.json and every share link are built from it
SIGNAGE_PUBLIC_BASE_URL=https://signage.example.com
SIGNAGE_COOKIE_SECURE=1

# the first administrator, created at start-up while there is no user yet (change the password after the first login)
SIGNAGE_ADMIN_EMAIL=admin@example.com
SIGNAGE_ADMIN_PASSWORD=change-this-to-a-long-password

# the largest upload / request body in MB (masters are 100-350 MB); Caddy allows 1100 MB
SIGNAGE_MAX_UPLOAD_MB=1024

# /healthz answers 503 when less than this many GB of disk are left
SIGNAGE_MIN_FREE_DISK_GB=2
