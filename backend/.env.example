# Copy to backend/.env (not committed) and adjust. Real environment variables override this file.

# Embedded photos above this many pixels per inch AT THE BOARD'S PRINTED SIZE are downsampled in every output .cdr/.pdf.
# 300 = print quality (default). 150 was measured on a 10x4 ft DARSHAN board: 31.3 s -> 24.2 s per shop, CDR 209 -> 168 MB,
# PDF 43 -> 30 MB, at the cost of sharpness up close. 0 = never downsample.
SIGNAGE_MAX_BITMAP_DPI=300

# Keep the master .cdr open between the shops of one conversion batch (each shop is undone and verified against the
# master before the next one). 0 = reopen the master for every shop, as before.
SIGNAGE_KEEP_MASTER_OPEN=1

# Master templates are stored and stay listed across restarts. Set to 1 to hide the previous run's masters on every start instead
# (soft delete: files and finished boards stay), so a designer begins again at Master 1.
# SIGNAGE_ARCHIVE_MASTERS_ON_START=0

# --- Login / security (app/auth.py) ---
# The API needs a login. First administrator: either set both variables below (created at start-up while there is no user),
# or open the app ON THE SERVER ITSELF once and fill in the "Create the administrator" form.
# SIGNAGE_ADMIN_EMAIL=admin@example.com
# SIGNAGE_ADMIN_PASSWORD=choose-a-long-password
# Local development only: 'off' disables the login (everybody is an administrator). Never set it on a shared server.
# SIGNAGE_AUTH=off
# Set to 1 when the site is served over HTTPS (also detected from X-Forwarded-Proto) so the session cookie is Secure.
# SIGNAGE_COOKIE_SECURE=1
# Other sites allowed to call the API (comma separated). Empty = same origin only, which the built app and the Vite proxy need.
# SIGNAGE_CORS_ORIGINS=https://signage.example.com
# Largest upload / request body in MB (masters are 100-350 MB).
# SIGNAGE_MAX_UPLOAD_MB=1024

# --- Server (production) ---
# Serve the built web app (frontend/dist) from this API: nothing to set when frontend/dist exists. Another build folder:
# SIGNAGE_FRONTEND_DIST=D:\signage\dist
# /healthz answers 503 when less than this many GB of disk are free.
# SIGNAGE_MIN_FREE_DISK_GB=2
# Refuse to start when the engine would be the MOCK one (no Windows / CorelDRAW): set it on a production machine.
# SIGNAGE_REQUIRE_REAL_ENGINE=1
